'
' After Insert/update/delete "export" to "Repository".
Private Sub Form_AfterDelConfirm(Status As Integer): Call add_if_not_there: End Sub
Private Sub Form_AfterInsert():                      Call add_if_not_there: End Sub
Private Sub Form_AfterUpdate():                      Call add_if_not_there: End Sub
'
' Generate "Unique"-code
Private Sub Form_BeforeInsert(Cancel As Integer): Me.Controls("id_" & Mid(Me.Name, 5)) = get_random_code(): End Sub
'
' If "Ingestion" then always check if there "adf - Azure Data Factory"-paramters.
Private Sub add_if_not_there()
    '
    ' Local Variables
    Dim sql As String: sql = ""
    Dim nwl As String: nwl = vbNewLine
    
    sql = sql & sql & "INSERT INTO dta_parameter_value (id_parameter_value, id_dataset, id_parameter, tx_parameter_value, ni_parameter_value) "
    sql = sql & nwl & "SELECT id_parameter_value, id_dataset, id_parameter, tx_parameter_value, ni_parameter_value FROM ("
    sql = sql & nwl & "SELECT '<id_parameter_value1           >' AS id_parameter_value,"
    sql = sql & nwl & "       '<id_dataset                    >' AS id_dataset,"
    sql = sql & nwl & "                         ptr.id_parameter AS id_parameter,"
    sql = sql & nwl & "                                    'n/a' AS tx_parameter_value,"
    sql = sql & nwl & "                                        1 AS ni_parameter_value"
    sql = sql & nwl & ""
    sql = sql & nwl & "FROM ("
    sql = sql & nwl & "    SELECT id_parameter, '<id_dataset                    >' AS id_dataset"
    sql = sql & nwl & "    FROM srd_parameter"
    sql = sql & nwl & "    WHERE nm_parameter = 'adf_1_cd_source_location_type'"
    sql = sql & nwl & ") AS ptr"
    sql = sql & nwl & ""
    sql = sql & nwl & "LEFT JOIN dta_parameter_value AS pvl ON pvl.id_parameter = ptr.id_parameter AND pvl.id_dataset = ptr.id_dataset"
    sql = sql & nwl & ""
    sql = sql & nwl & "WHERE pvl.id_parameter_value IS NULL"
    sql = sql & nwl & ""
    sql = sql & nwl & "UNION"
    sql = sql & nwl & ""
    sql = sql & nwl & "SELECT '<id_parameter_value2           >' AS id_parameter_value,"
    sql = sql & nwl & "       '<id_dataset                    >' AS id_dataset,"
    sql = sql & nwl & "                         ptr.id_parameter AS id_parameter,"
    sql = sql & nwl & "                                    'n/a' AS tx_parameter_value,"
    sql = sql & nwl & "                                        2 AS ni_parameter_value"
    sql = sql & nwl & ""
    sql = sql & nwl & "FROM ("
    sql = sql & nwl & "    SELECT id_parameter, '<id_dataset                    >' AS id_dataset"
    sql = sql & nwl & "    FROM srd_parameter"
    sql = sql & nwl & "    WHERE nm_parameter = 'adf_2_cd_source_dataset_type'"
    sql = sql & nwl & ") AS ptr"
    sql = sql & nwl & ""
    sql = sql & nwl & "LEFT JOIN dta_parameter_value AS pvl ON pvl.id_parameter = ptr.id_parameter AND pvl.id_dataset = ptr.id_dataset"
    sql = sql & nwl & ""
    sql = sql & nwl & "WHERE pvl.id_parameter_value IS NULL) AS u"
    sql = Replace(sql, "<id_parameter_value1           >", get_random_code)
    sql = Replace(sql, "<id_parameter_value2           >", get_random_code)
    sql = Replace(sql, "<id_dataset                    >", Me.id_dataset)
    '
    ' Execute SQL
    DoCmd.SetWarnings False
    DoCmd.RunSQL sql
    DoCmd.SetWarnings True
    '
    ' Uupdate Export/Import files
    Call btn_Save_Click_for_dataset(Me, "n/a", Mid(Me.Name, 5))
    '
End Sub