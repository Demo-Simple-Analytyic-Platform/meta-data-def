Private Sub Form_Load()

    Me.tx_loading_feedback.Width = Abs(Me.WindowWidth)
    Me.tx_loading_feedback.Height = Me.WindowHeight - (Me.Formulierkoptekst.Height + 300)
    DoEvents

End Sub

Private Sub Form_Timer()

    ' Uitzetten Timer!
    Me.TimerInterval = 0

    Call StartUp

End Sub

Private Function nm_user_name() As String

    nm_user_name = Environ("Username")
    
End Function

Private Sub remember_path_git(tx_path_repos As String)
    '
    ' Local Variables
    Dim c As Credentials: Set c = New Credentials
    '
    Dim fso As FileSystemObject: Set fso = New FileSystemObject
    '
End Sub


Public Sub StartUp(): On Error GoTo err_handle
    '
    ' Local Variables
    Dim fso As FileSystemObject: Set fso = New FileSystemObject
    Dim cd_extention   As String:    cd_extention = Right(CurrentProject.Name, 5)
    Dim nm_application As String:  nm_application = Replace(CurrentProject.Name, "." & cd_extention, "")
    Dim tx_path_local  As String:   tx_path_local = tx_user_folder() & nm_application & "\"
    Dim tx_path_actual As String:  tx_path_actual = CurrentProject.Path & "\"
    Dim is_development As Boolean: is_development = mdl_Folders.is_development_version
    '
    ' If started from PowerShell there should be a file called "PowerShellStart.txt".
    If (fso.FileExists(CurrentProject.Path & "\PowerShellStart.txt") = True) Then
        Call mdl_Folders.save_tx_path_repos(mdl_Folders.tx_repo_folderpath(mdl_Folders.nm_repository))
        Call tx_loading_progress_reset
        Call mdl_Import.process_all_sql_files(Me)
        Call fso.DeleteFile(CurrentProject.Path & "\PowerShellStart.txt")
        DoCmd.Close acForm, "StartUp"
        Application.Quit
        Exit Sub
    End If
    '
    ' Check if this is NOT the "Template"
    If (mdl_Folders.nm_repository = "meta-data-def") Then
        If MsgBox("This is the `Template`-repository, NO datadefintions should be placed here!" & vbNewLine & _
                    "Would you like to set `model/repository`-folder?" & vbNewLine & _
                    "(the required folders and file will be copied here", vbYesNo) = vbNo Then
            Application.Quit
        Else ' Yes
            '
            ' Open Copy to New Model
            DoCmd.OpenForm "CopyToNewModel", acNormal, , , acFormEdit, acDialog
            '
            ' Open "New" Model Editor Tool
            Call MsgBox("The new `Model` metadata Editor will started, any change to `meta-data-def`-repository should be ignored/disgarded!", vbInformation)
            '
            ' Local Variables
            Dim objAcc As Object: Set objAcc = CreateObject("Access.Application")
            '
            ' Open "copy" application
            objAcc.OpenCurrentDatabase tx_path_local & nm_application & "." & cd_extention
            '
            ' Maximize the Access application window
            objAcc.DoCmd.RunCommand acCmdAppMaximize
            '
            ' Make the Access application visible
            objAcc.UserControl = True
            '
            ' Bring the Access application window to the foreground
            Dim hwnd As LongPtr: hwnd = objAcc.hWndAccessApp
            SetForegroundWindow hwnd
            '
            ' Close current (in de repository) Application
            Application.Quit
            '
        End If
    End If
    '
    ' Save location of "Repos".
    Call mdl_Folders.save_tx_path_repos(mdl_Folders.tx_repo_folderpath(mdl_Folders.nm_repository))
    '
    ' detect if running from development-folder!
    If (is_development = True) Then
        '
        ' Infor user this the "Development" version.
        Call MsgBox("This instants is running from `Development-version`-folder!", vbInformation, "Development version!")
        '
    End If
    '
    ' reset
    Call tx_loading_progress_reset
    '
    ' Import all SQL-files.
    Call mdl_Import.process_all_sql_files(Me)
    '
    ' Start loading meta-data
    DoCmd.OpenForm "menu_meta_data_editor", acNormal
    '
    ' Close StatUp
    DoCmd.Close acForm, Form_StartUp.Name, acSaveNo
    '
Exit Sub
'
err_handle:
    '
    ' Print Error
    Debug.Print ("--- Error --------------------------------------------------------------")
    Debug.Print ("Err Number      : " & CStr(Err.Number))
    Debug.Print ("Err Description : " & Err.Description)
    Stop
    '
End Sub

Public Sub tx_loading_progress_reset()
    '
    ' Reset Couters
    ni_max_nr_bars = Len("|||||||||||||||||||||||||||||||||||||||||||||||||||")
    ni_number_bars = 0
    ni_progress_todo = 9999999999# 'count_number_of_lines()
    ni_progress_done = 0
    pr_processs_done = 0
    ni_wait_time = Round(10 * (1 / ni_progress_todo), 0)
    Me.tx_loading_progress.Caption = pr_processs_done
    Me.tx_loading_feedback.Caption = ""
    
End Sub
Public Sub tx_loading_progress_add()
    '
    ' Update done
    ni_progress_done = ni_progress_done + 1
    pr_progress_done = Round(ni_progress_done / ni_progress_todo, 4)
    ni_number_bars = Round(pr_progress_done * ni_max_nr_bars, 0)
    '
    ' Local Variabels
    Dim tx As String
    tx = Format(pr_progress_done * 100, "0.00")
    tx = String(6 - Len(tx), " ") & tx
    Me.tx_loading_progress.Caption = tx & " % - " & String(ni_number_bars, "|")
    '
End Sub