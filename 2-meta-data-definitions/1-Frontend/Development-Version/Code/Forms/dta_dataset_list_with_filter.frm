Private Sub btn_clear_filtyers_Click()
  '
  ' Remove filter
  Me.tx_filter_fn_dataset = ""
  Me.dta_databaset_list.Form.Filter = "": Me.dta_databaset_list.Form.FilterOn = True
  '
End Sub

Private Sub tx_filter_fn_dataset_Change(): On Error GoTo errHandle
  '
  ' Clean Immediate window
  Debug.Print vbNewLine
  Debug.Print String(40, "-")
  '
  ' remmeber cursor position
  Dim ni_cursor_position As Integer: ni_cursor_position = Me.tx_filter_fn_dataset.SelStart
  Dim tx_filter_old      As String:  tx_filter_old = Me.tx_filter_fn_dataset
  Debug.Print "Old: " & tx_filter_old
  '
  ' Leave Control
  Me.tx_helper.SetFocus
  '
  Dim tx_filter         As String:  tx_filter = Me.dta_databaset_list.Form.Filter
  
  Dim tx_filter_new     As String:  tx_filter_new = Me.tx_filter_fn_dataset
  Debug.Print "new: " & tx_filter_new
  '
  ' Remove filter
  Me.dta_databaset_list.Form.Filter = "": Me.dta_databaset_list.Form.FilterOn = True
  '
  Debug.Print "Before: " & tx_filter
  '
  tx_filter = Replace(tx_filter, "AND [fn_dataset] Like '*" & tx_filter_old & "*'", "")
  tx_filter = Replace(tx_filter, "[fn_dataset] Like '*" & tx_filter_old & "*'", "")
  '
  ' Set Filter
  tx_filter = Trim(tx_filter) & IIf(Len(tx_filter) = 0, "", " AND ") & "[fn_dataset] LIKE '*" & tx_filter_new & "*'"
  Debug.Print "After: " & tx_filter
  Me.dta_databaset_list.Form.Filter = tx_filter
  Me.dta_databaset_list.Form.FilterOn = True
  '
  ' Set cursor filter filter  again
  Me.tx_helper = "help"
  Me.tx_filter_fn_dataset.SetFocus
  Me.tx_filter_fn_dataset.SelStart = ni_cursor_position
  '
  ' All Done
  Exit Sub
  '
errHandle:
  Debug.Print Err.Description
  Exit Sub
  '
End Sub