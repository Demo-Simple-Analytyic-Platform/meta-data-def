Private Sub btn_pg_step_2_generate_mapping_Click()
    '
    ' Local Variables
    Dim sql As String
    Dim n As String: n = vbNewLine
    '
    ' Build SQL Statement to delete "hlp_attribute_with_mapping".
    sql = "DELETE * FROM hlp_attribute_with_mapping"
    DoCmd.SetWarnings False: DoCmd.RunSQL sql: DoCmd.SetWarnings True
    '
    ' Build SQL Statement to INSERT "hlp_attribute_with_mapping".
    sql = "INSERT INTO hlp_attribute_with_mapping ( id_dataset_target, id_attribute_target, id_dataset_source, id_attribute_source ) " _
    & n & "SELECT tgt.id_dataset_target, tgt.id_attribute_target, tgt.id_dataset_source, att.id_attribute AS id_attribute_source " _
    & n & "FROM (SELECT tgt.id_dataset AS id_dataset_target, tgt.id_attribute AS id_attribute_target, x.id_dataset_tobe_unioned AS id_dataset_source, tgt.ni_ordering " _
    & n & "      FROM hlp_union_more_then_2_datasets AS x LEFT JOIN dta_attribute AS tgt ON x.id_dataset = tgt.id_dataset ) AS tgt LEFT " _
    & n & "      JOIN dta_attribute AS att ON (tgt.ni_ordering = att.ni_ordering) AND (tgt.id_dataset_source = att.id_dataset)"
    Debug.Print sql: DoCmd.SetWarnings False: DoCmd.RunSQL sql: DoCmd.SetWarnings True
    '
    ' Refresh
    Me.hlp_union_more_then_2_datasets_list.Requery
    Me.hlp_attribute_with_mapping_list.Requery
    '
    ' show Step 2: Inspect source attributes
    Me.pg_step_2_inspect_attributes.SetFocus
    '
End Sub

Public Function build_sql_tx_source_query() As String
    '
    ' Local Variable
    Dim n   As String: n = vbNewLine
    Dim sql As String: sql = ""
    Dim rst As String: rst = ""
    Dim fst As Boolean
    
    Dim dst As Recordset
    Dim att As Recordset
    
    sql = "SELECT DISTINCT dst.id_dataset       AS id_source_dataset" _
    & n & "              , dst.nm_target_schema AS nm_source_schema" _
    & n & "              , dst.nm_target_table  AS nm_source_table" _
    & n & "FROM hlp_attribute_with_mapping AS map " _
    & n & "LEFT " _
    & n & "JOIN dta_dataset AS dst " _
    & n & " ON map.id_dataset_source = dst.id_dataset " _
    & n & "" _
    & n & "ORDER BY dst.nm_target_schema ASC" _
    & n & "       , dst.nm_target_table ASC" _
    & n & ""
    
    'Debug.Print sql
    Set dst = CurrentDb.OpenRecordset(sql)
    
    Do While (Not dst.EOF)
        sql = "SELECT tgt.ni_ordering       AS ni_ordering" _
        & n & "     , dst.nm_target_schema  AS nm_source_schema" _
        & n & "     , dst.nm_target_table   AS nm_source_table" _
        & n & "     , att.nm_target_column  AS nm_source_column" _
        & n & "     , map.tx_mapping_source AS tx_mapping_source" _
        & n & "     , tgt.nm_target_column  AS nm_target_column" _
        & n & "FROM ((hlp_attribute_with_mapping AS map " _
        & n & "LEFT " _
        & n & "JOIN dta_dataset AS dst " _
        & n & " ON map.id_dataset_source = dst.id_dataset) " _
        & n & "LEFT " _
        & n & "JOIN dta_attribute AS att " _
        & n & " ON map.id_attribute_source = att.id_attribute) " _
        & n & "INNER " _
        & n & "JOIN dta_attribute AS tgt " _
        & n & " ON map.id_attribute_target = tgt.id_attribute " _
        & n & "WHERE map.id_dataset_source = '" & dst.fields("id_source_dataset") & "' " _
        & n & "ORDER BY dst.nm_target_schema ASC" _
        & n & "       , dst.nm_target_table  ASC" _
        & n & "       , tgt.ni_ordering      ASC" _
        & n & ""
        
        ' Debug.Print sql
        Set att = CurrentDb.OpenRecordset(sql)
        
        sql = "SELECT"
        fst = True
        
        Do While (Not att.EOF)
            
            If (fst = True) Then
                sql = sql & " "
                fst = False
            Else
                sql = sql & n & "     , "
            End If
            
            If (Nz(att.fields("nm_source_column"), "n/a") = "n/a") Then
                sql = sql & att.fields("tx_mapping_source")
            Else
                sql = sql & "[src].[" & att.fields("nm_source_column") & "]"
            End If
            
            sql = sql & " AS [" & att.fields("nm_target_column") & "]"
                
        att.MoveNext: Loop
    
        sql = sql & n & "FROM [" & dst.fields("nm_source_schema") & "].[" & dst.fields("nm_source_table") & "] AS [src]"
        rst = rst & IIf(rst = "", "", n & n & "UNION ALL" & n & n) & sql
    
    dst.MoveNext: Loop
    '
    build_sql_tx_source_query = rst
    '
End Function

Private Sub btn_pg_step_3_validate_source_query_Click()
    '
    ' Build SQL Source Query
    Me.tx_source_query = build_sql_tx_source_query()
    DoCmd.RunCommand acCmdSaveRecord
    '
    ' show Step 3: Validate SQL Source Query
    Me.pg_step_3_validate_source_query.SetFocus
