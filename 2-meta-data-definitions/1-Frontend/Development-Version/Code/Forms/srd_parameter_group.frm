Attribute VB_Creatable = True
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Compare Database
Option Explicit
'
' After Insert/update/delete "export" to "Repository".
Private Sub Form_AfterDelConfirm(Status As Integer): mdl_Export.export_table Left(Me.Name, 3), Mid(Me.Name, 5): End Sub
Private Sub Form_AfterInsert():                      mdl_Export.export_table Left(Me.Name, 3), Mid(Me.Name, 5): End Sub
Private Sub Form_AfterUpdate():                      mdl_Export.export_table Left(Me.Name, 3), Mid(Me.Name, 5): End Sub
'
' Generate "Unique"-code
Private Sub Form_BeforeInsert(Cancel As Integer): Me.Controls("id_" & Mid(Me.Name, 5)) = get_random_code(): End Sub