Private Sub btn_copy_to_new_model_Click()
    '
    ' Block text input field
    Me.tx_folderpath_new_model.Enabled = False
    '
    ' Variables
    Dim fso       As FileSystemObject: Set fso = New FileSystemObject
    Dim nm_repo   As String: nm_repo = tx_git_folder & nm_repository & "\"
    Dim nm_file   As String
    Dim nm_folder As String
    '
    ' Add "\" if not already last character
    Me.tx_folderpath_new_model = Me.tx_folderpath_new_model & IIf(Right(Me.tx_folderpath_new_model, 1) = "\", "", "\")
    '
    ' Check if target exists
    If (fso.FolderExists(Me.tx_folderpath_new_model) = False) Then
        Call MsgBox("Selected folder `" & Me.tx_folderpath_new_model & "` does NOT exists!", vbCritical)
        Me.tx_folderpath_new_model.Enabled = True
        Exit Sub
    End If
    '
    ' Check the length of the "Target"-folder, which should be the "name" of the new "model", max. allowed length is 16.
    If (Len(fso.GetFolder(Me.tx_folderpath_new_model).Name) > 16) Then
        Call MsgBox("The max allowed length of a `new` model is 16 characters!" & vbNewLine & _
                    "(The model/repository-name is hashed into 32-character" & vbNewLine & _
                    "long hash, names longer then 16 will cause collitions" & vbNewLine & _
                    "in the hashing. The name of folder should reflext the" & vbNewLine & _
                    "name of the repository)", vbExclamation)
        Me.tx_folderpath_new_model.Enabled = True
        Exit Sub
    End If
    '
    ' Copy all files/folder from `meta-data-def`-folder to `new` model folder.
    nm_file = "meta-data-definitions.sln": Call fso.CopyFile(nm_repo & nm_file, Me.tx_folderpath_new_model & nm_file, True)
    nm_file = "LICENSE":                   Call fso.CopyFile(nm_repo & nm_file, Me.tx_folderpath_new_model & nm_file, True)
    nm_file = ".gitignore":                Call fso.CopyFile(nm_repo & nm_file, Me.tx_folderpath_new_model & nm_file, True)
    nm_folder = "0-secrets":               Call fso.CopyFolder(nm_repo & nm_folder, Me.tx_folderpath_new_model & nm_folder, True)
    nm_folder = "2-meta-data-definitions": Call fso.CopyFolder(nm_repo & nm_folder, Me.tx_folderpath_new_model & nm_folder, True)
    nm_folder = "4-processing-python":     Call fso.CopyFolder(nm_repo & nm_folder, Me.tx_folderpath_new_model & nm_folder, True)
    '
    ' Local Variables
    Dim objAcc As Object: Set objAcc = CreateObject("Access.Application")
    '
    ' Open "copy" application
    objAcc.OpenCurrentDatabase Me.tx_folderpath_new_model & "2-meta-data-definitions\1-Frontend\ms-access-frontend.accdb"
    '
    ' Maximize the Access application window
    objAcc.DoCmd.RunCommand acCmdAppMaximize
    '
    ' Make the Access application visible
    objAcc.UserControl = True
    '
    ' Bring the Access application window to the foreground
    Dim hwnd As LongPtr: hwnd = objAcc.hWndAccessApp
    SetForegroundWindow hwnd
    '
    ' Close current (in de repository) Application
    Application.Quit
    '
End Sub

Private Sub Form_Load()
    Me.tx_folderpath_new_model.Enabled = True
    DoCmd.Close acForm, "StartUp", acSaveNo
End Sub