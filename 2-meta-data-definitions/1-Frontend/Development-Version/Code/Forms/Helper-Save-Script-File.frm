Private Sub Form_Load()
    '
    ' Set form to fore ground
    Me.SetFocus
    '
    ' Set Timer
    Me.TimerInterval = 250
    '
    ' Initialize progress bar
    p_ni_bar = 0
    p_ni_percentage = 0
    p_ni_cur_iteration = -1
    p_ni_max_iterations = 1
    Call update_progress_bar("Initializing ...")
    '
End Sub

Private Sub Form_Timer()
    '
    ' Stop Timer
    Me.TimerInterval = 0
    '
    ' Start Saving defintions reference to File Script
    Call save
    '
End Sub