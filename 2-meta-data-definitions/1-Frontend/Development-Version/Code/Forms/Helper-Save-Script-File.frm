Private Const p_ni_max_bars As Currency = 24
Private p_ni_percentage     As Currency
Private p_ni_bar            As Currency
Private p_ni_max_iterations As Currency
Private p_ni_cur_iteration  As Currency
'
'
' ---------------------------------------------------------------------------
' Update Progress Bar to provide user with progress and made waiting barable
' ---------------------------------------------------------------------------
Public Sub update_progress_bar(ByVal ip_nm_file As String)
    '
    ' Add 1 to the number of Iterations
    p_ni_cur_iteration = p_ni_cur_iteration + 1
    '
    ' Calculate number of "bars"
    p_ni_bar = Round(p_ni_max_bars * (p_ni_cur_iteration / p_ni_max_iterations), 0)
    p_ni_percentage = Round(100 * (p_ni_cur_iteration / p_ni_max_iterations), 0)
    '
    ' Update the Progress Bars on the Form
    Me.ni_percentage.Caption = CStr(p_ni_percentage) & "%"
    Me.tx_progress_bar.Caption = IIf(p_ni_bar = 0, "", Replace(Space(p_ni_bar), " ", "|"))
    Me.tx_nm_file.Caption = ip_nm_file
    '
    ' Do Events
    DoEvents
    '
    ' Wait 250 millseconds
    Sleep (250 / p_ni_max_iterations)
    '
End Sub
