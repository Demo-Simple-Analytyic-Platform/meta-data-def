Private Sub Form_Timer()
    '
    ' Local Variables
    Dim fso As FileSystemObject: Set fso = New FileSystemObject
    Dim fp_waiting As String:  fp_waiting = "C:\temp\deployment_of_" & nm_repository & ".wait"
    '
    Me.tx_waitig = IIf(Len(Me.tx_waitig) < 10, "Processing .", Me.tx_waitig)
    Me.tx_waitig = IIf(Len(Me.tx_waitig) = (15 + Len("Processing ")), "Processing .", Me.tx_waitig & ".")
    DoEvents
    If (fso.FileExists(fp_waiting) = False) Then
        DoCmd.Close acForm, "waiting", acSaveNo
    End If
    
End Sub