Private Sub btn_Reference_Dataset_Click()
    '
    Dim sql As String
    Dim nwl As String: nwl = vbNewLine
    Dim rst As Recordset
    Dim att As Recordset
    Dim mxo As Integer
    '
    ' Generate new_id_dataset
    Dim new_id_dataset As String: new_id_dataset = get_random_code(32)
    '
    ' Copy the following table record of provided id_dataset and give theme new id`s.
    Call copy_table_record(Me.id_model, Me.id_dataset, new_id_dataset, "dta_dataset")
    Call copy_table_record(Me.id_model, Me.id_dataset, new_id_dataset, "dta_schedule")
    Call copy_table_record(Me.id_model, Me.id_dataset, new_id_dataset, "dta_attribute")
    '
    ' Add "dt_valid_begin" and "dt_valid_ended" as attributes
    Set rst = CurrentDb.OpenRecordset("SELECT max(ni_ordering) as mxo FROM dta_attribute WHERE id_dataset ='" & new_id_dataset & "'")
    mxo = rst!mxo: rst.Close: Set rst = CurrentDb.OpenRecordset("SELECT * FROM dta_attribute WHERE 1=2")
    '
    ' Add Column : dt_valid_begin
    rst.AddNew
    rst!id_model = id_model_default
    rst!id_attribute = get_random_code(32)
    rst!id_dataset = new_id_dataset
    rst!id_datatype = "080c0105030f0a06050b0e0004140d00"
    rst!fn_attribute = "Valid Begin"
    rst!fd_attribute = "Datetime on begins the validity of record."
    rst!ni_ordering = mxo + 1
    rst!nm_target_column = "dt_valid_begin"
    rst!is_businesskey = False
    rst!is_nullable = False
    rst.Update
    '
    ' Add Column : dt_valid_ended
    rst.AddNew
    rst!id_model = id_model_default
    rst!id_attribute = get_random_code(32)
    rst!id_dataset = new_id_dataset
    rst!id_datatype = "080c0105030f0a06050b0e0004140d00"
    rst!fn_attribute = "Valid Ended"
    rst!fd_attribute = "Datetime which the validity of record is ended."
    rst!ni_ordering = mxo + 2
    rst!nm_target_column = "dt_valid_ended"
    rst!is_businesskey = False
    rst!is_nullable = False
    rst.Update
    '
    ' Add Parameters for "referenced from"-information.
    Dim cd_parameter_group As String: cd_parameter_group = IIf(is_reference_model_other_db(Me.id_model) = True, "rdo_referenced_dataset_other_db", "rds_referenced_dataset_same_db")
    Call add_parameter_value(cd_parameter_group, 1, Left(cd_parameter_group, 3) & "_1_id_model", Me.id_model, new_id_dataset)
    Call add_parameter_value(cd_parameter_group, 2, Left(cd_parameter_group, 3) & "_2_id_dataset", Me.id_dataset, new_id_dataset)
    '
    ' Set the "target"-schema/table
    Dim dst As Recordset: Set dst = CurrentDb.OpenRecordset("SELECT * FROM dta_dataset WHERE id_dataset = '" & new_id_dataset & "' AND id_model = '" & id_model_default & "'")
    dst.Edit
    dst!nm_target_schema = Me.nm_target_schema
    dst!nm_target_table = Me.nm_target_table
    dst!fn_dataset = Me.fn_dataset & " (Referenced)"
    dst!tx_source_query = "n/a -> this is a `Referenced`-dataset! the `other` model is responisble for loading the data."
    dst.Update
    dst.Close
    If (is_reference_model_other_db(Me.id_model) = True) Then
        '
        ' Add SQL Source infromation
        sql = "SELECT * FROM dta_database WHERE id_model = '" & Me.id_model & "'"
        Dim dbo As Recordset: Set dbo = CurrentDb.OpenRecordset(sql)
        cd_parameter_group = "sql_user_password"
        Call add_parameter_value(cd_parameter_group, 3, "sql_1_nm_server", dbo!nm_server, new_id_dataset)
        Call add_parameter_value(cd_parameter_group, 4, "sql_2_nm_username", dbo!nm_username, new_id_dataset)
        Call add_parameter_value(cd_parameter_group, 5, "sql_3_nm_database", dbo!nm_database, new_id_dataset)
        Call add_parameter_value(cd_parameter_group, 6, "sql_4_nm_schema", Me.nm_target_schema, new_id_dataset)
        Call add_parameter_value(cd_parameter_group, 7, "sql_5_nm_table", Me.nm_target_table, new_id_dataset)
        Call add_parameter_value(cd_parameter_group, 8, "sql_6_nm_secret", dbo!nm_secret, new_id_dataset)
        '
        ' Build SQL Statement for "tx_source_query"
        Dim tx_source_query As String
        sql = "SELECT nm_target_column" & vbNewLine _
            & "FROM dta_attribute" & vbNewLine _
            & "WHERE id_model   = '" & id_model_default() & "'" & vbNewLine _
            & "AND   id_dataset = '" & new_id_dataset & "'"
        Set att = CurrentDb.OpenRecordset(sql)
        sql = "": Do While (Not att.EOF): sql = sql & "[tsl].[" & att!nm_target_column & "]," & vbNewLine & "       ": att.MoveNext: Loop
        sql = "SELECT " & Mid(sql, 1, (Len(sql) - Len("," & vbNewLine & "       ")))
        sql = sql & nwl & "FROM [tsl_" & Me.nm_target_schema & "].[tsl_" & Me.nm_target_table & "] AS [tsl]"
        tx_source_query = sql
        '
        ' Build SQL Statement for "sql_7_tx_query"
        Dim sql_7_tx_query As String
        sql = "SELECT nm_target_column" & vbNewLine _
            & "FROM dta_attribute" & vbNewLine _
            & "WHERE id_model   = '" & id_model_default() & "'" & vbNewLine _
            & "AND   id_dataset = '" & new_id_dataset & "'"
        Set att = CurrentDb.OpenRecordset(sql)
        sql = "": Do While (Not att.EOF): sql = sql & "[src].[" & att!nm_target_column & "]," & nwl & "       ": att.MoveNext: Loop
        sql = "SELECT " & sql _
                    & "[src].[meta_dt_valid_from] AS [dt_valid_begin]," & nwl & "       " _
                    & "[src].[meta_dt_valid_till] AS [dt_valid_ended]" & nwl
        sql = sql & "FROM [" & Me.nm_target_schema & "].[" & Me.nm_target_table & "] AS [src]" & nwl
        sql = sql & "WHERE ([src].[meta_dt_valid_from] >= '<@dt_previous_stand>' AND [src].[meta_dt_valid_from] <= '<@dt_current_stand>')" & nwl
        sql = sql & "   OR ([src].[meta_dt_valid_till] >= '<@dt_previous_stand>' AND [src].[meta_dt_valid_till] <= '<@dt_current_stand>')" & nwl
        sql_7_tx_query = sql
        '
        ' Add Query to be executed on `External`-database.
        Call add_parameter_value(cd_parameter_group, 9, "sql_7_tx_query", sql_7_tx_query, new_id_dataset)
        '
        ' Update "Dataset".
        Set dst = CurrentDb.OpenRecordset("SELECT * FROM dta_dataset WHERE id_dataset = '" & new_id_dataset & "'")
        dst.Edit
        dst!tx_source_query = tx_source_query
        dst!is_ingestion = True
        dst.Update
        dst.Close
        '
        ' Update ETL
        Call copy_table_record(Me.id_model, Me.id_dataset, new_id_dataset, "dta_ingestion_etl")
        Dim etl As Recordset: Set etl = CurrentDb.OpenRecordset("SELECT * FROM dta_ingestion_etl WHERE id_model = '" & id_model_default & "' AND id_dataset = '" & new_id_dataset & "'")
        etl.Edit
        etl!nm_processing_type = "Incremental"
        etl!tx_sql_for_meta_dt_valid_from = "[tsl].[dt_valid_begin]"
        etl!tx_sql_for_meta_dt_valid_till = "[tsl].[dt_valid_ended]"
        etl.Update
        etl.Close
        '
    End If
    '
    ' Have the form open the "new" dataset.
    Call DoCmd.OpenForm(Me.Name, acNormal, , "id_dataset = '" & new_id_dataset & "'", acFormEdit, acWindowNormal)
    Call btn_Save_Click
    Form_dta_dataset_list.Requery
    Call Form_Load
    '
End Sub
Public Function is_reference_model_other_db(ip_id_model_referenced As String) As Boolean
    Dim dbc As Recordset: Set dbc = CurrentDb.OpenRecordset("SELECT nm_database FROM dta_database WHERE id_model = '" & id_model_default & "'")
    Dim dbr As Recordset: Set dbr = CurrentDb.OpenRecordset("SELECT nm_database FROM dta_database WHERE id_model = '" & ip_id_model_referenced & "'")
    is_reference_model_other_db = (IIf(dbc.EOF, "n/a", dbc!nm_database) <> dbr!nm_database)
    dbc.Close
    dbr.Close
End Function
Private Sub add_parameter_value(ip_cd_parameter_group As String, ip_ni_parameter_value As Integer, ip_nm_parameter As String, ip_tx_parameter_value As String, ip_id_dataset As String)
    Dim rst As Recordset
    Set rst = CurrentDb.OpenRecordset("SELECT * FROM dta_parameter_value WHERE 1=2")
    rst.AddNew
    rst!id_model = id_model_default()
    rst!id_dataset = ip_id_dataset
    rst!id_parameter = id_parameter(ip_nm_parameter, ip_cd_parameter_group)
    rst!id_parameter_value = get_random_code()
    rst!ni_parameter_value = ip_ni_parameter_value
    rst!tx_parameter_value = ip_tx_parameter_value
    rst.Update
    rst.Close
End Sub
Private Function id_parameter(ip_nm_parameter As String, ip_cd_parameter_group As String) As String
    Dim sql As String: sql = "SELECT id_parameter" & vbNewLine _
                           & "FROM srd_parameter" & vbNewLine _
                           & "WHERE id_parameter_group = '" & id_parameter_group(ip_cd_parameter_group) & "'" & vbNewLine _
                           & "AND   nm_parameter       = '" & ip_nm_parameter & "'" & vbNewLine _
                           & "AND   id_model           = '" & id_model_default() & "'"
    Dim rst As Recordset: Set rst = CurrentDb.OpenRecordset(sql)
    If rst.EOF Then
        id_parameter = "n/a"
    Else
        id_parameter = rst!id_parameter
    End If
    rst.Close
End Function
Private Function id_parameter_group(ip_cd_parameter_group As String) As String
    Dim sql As String: sql = "SELECT id_parameter_group" & vbNewLine _
                           & "FROM srd_parameter_group" & vbNewLine _
                           & "WHERE cd_parameter_group = '" & ip_cd_parameter_group & "'" & vbNewLine _
                           & "AND   id_model           = '" & id_model_default() & "'"
    Dim rst As Recordset: Set rst = CurrentDb.OpenRecordset(sql)
    If rst.EOF Then
        id_parameter_group = "n/a"
    Else
        id_parameter_group = rst!id_parameter_group
    End If
    rst.Close
End Function
