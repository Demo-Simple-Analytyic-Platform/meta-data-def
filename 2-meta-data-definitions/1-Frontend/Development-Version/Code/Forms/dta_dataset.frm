Private Sub btn_create_source_query_from_attributes_Click()
    Dim generate As Boolean: generate = False
    If (Len(Nz(Me.tx_source_query, "")) <> 0) Then
        If (MsgBox("this action will overwrite the existing query, would you like to continue?", vbYesNo) = vbYes) Then
            generate = True
        End If
    Else
        generate = True
    End If
    If (generate = True) Then
        Dim rst As Recordset: Set rst = CurrentDb.OpenRecordset("SELECT * FROM dta_attribute WHERE id_dataset = '" & Me.id_dataset & "' ORDER BY ni_ordering")
        Me.tx_source_query = ""
        Do While Not rst.EOF
            Me.tx_source_query = Me.tx_source_query & IIf(Me.tx_source_query = "", "SELECT ", vbNewLine & "     , ") & "tsl.[" & rst.fields("nm_target_column") & "]"
        rst.MoveNext: Loop
        Me.tx_source_query = Me.tx_source_query & vbNewLine & vbNewLine & "FROM [tsl_" & Me.nm_target_schema & "].[tsl_" & Me.nm_target_table & "] AS tsl"
    End If

End Sub

