Private Sub btn_Save_Click()
    '
    ' Replace Tabs with spaces
    Me.tx_source_query = Replace(Me.tx_source_query, vbTab, "  ")
    '
    ' Set meta_updated_at
    Me.meta_updated_at = Now()
    '
    DoCmd.RunCommand acCmdSaveRecord
    '
    ' Determine is SOurce Query has NO Subqueries of CTE`s
    Call tx_source_query_AfterUpdate
    If (is_source_query_ok = False) Then Exit Sub
    '
    ' If Transformation (NOT ingestion) then ..
    If Not Me.is_ingestion Then
        '
        ' Declare Local Variables for remembering "Source Query" as is.
        Dim l_tx_source_query As String: l_tx_source_query = Me.tx_source_query
        '
        ' extract transformation_part(_attribute), transformation_dataset(_attribute), transformation_column_mapping(_attribute).
        Call parse_transformation_parts(Me.id_model, Me.id_dataset)
        '
        ' Re-build the source query based on extracted transformation_part(_attribute), transformation_dataset(_attribute), transformation_column_mapping(_attribute) info
        Me.tx_source_query = build_source_query(Me.id_model, Me.id_dataset, False)
        DoCmd.RunCommand acCmdSaveRecord
        '
        ' R-evaluate the Source Query
        Call tx_source_query_AfterUpdate
        If (is_source_query_ok = False) Then
            If (MsgBox("Would you like to restore the `original`-version of your ` Source Query`?", vbYesNo, "!!! Inval Source Query !!!") = vbYes) Then
                Me.tx_source_query = l_tx_source_query
                DoCmd.RunCommand acCmdSaveRecord
            End If
            Exit Sub
        End If
    End If
    '
    ' Save Dataset to File/Git Repository
    Call mdl_Forms.btn_Save_Click_for_dataset(Me, "dta_dataset_list", "dataset")
    '
    ' Loop throught all dataset that have current "dataset" as a source
    Dim sql As String: sql = ""
    Dim emp As String: emp = ""
    Dim nwl As String: nwl = vbNewLine
    Dim dbs As DAO.Database:  Set dbs = CurrentDb
    Dim dst As DAO.Recordset
    Dim rst As DAO.Recordset
    '
    ' Build SQL Statement to empty the temp table
    sql = emp & emp & "DELETE FROM tmp_effected_datasets;"
    DoCmd.SetWarnings False: DoCmd.RunSQL sql: DoCmd.SetWarnings True
    '
    ' Build SQL Statement to find all involved Datasets
    sql = emp & emp & "INSERT INTO tmp_effected_datasets (id_model, id_dataset)"
    sql = sql & nwl & ""
    sql = sql & nwl & "SELECT eff.id_model, eff.id_dataset"
    sql = sql & nwl & ""
    sql = sql & nwl & "FROM (((   dta_model                  As mdl"
    sql = sql & nwl & "INNER JOIN dta_dataset                AS dst ON               (mdl.id_model = dst.id_model))"
    sql = sql & nwl & "INNER JOIN dta_transformation_dataset AS tds ON             (dst.id_dataset = tds.id_source_dataset)      AND (dst.id_model = tds.id_source_model))"
    sql = sql & nwl & "INNER JOIN dta_transformation_part    AS tpt ON (tds.id_transformation_part = tpt.id_transformation_part) AND (tds.id_model = tpt.id_model))"
    sql = sql & nwl & "INNER JOIN dta_dataset                AS eff ON             (tpt.id_dataset = eff.id_dataset)             AND (tpt.id_model = eff.id_model)"
    sql = sql & nwl & ""
    sql = sql & nwl & "WHERE (([dst].[meta_updated_at] > [mdl].[meta_updated_at]) OR ([dst].[meta_created_at] > [mdl].[meta_updated_at]))"
    sql = sql & nwl & "AND   ([dst].[id_model]   = '" & Me.id_model & "')"
    sql = sql & nwl & "AND   ([dst].[id_dataset] = '" & Me.id_dataset & "');"
    DoCmd.SetWarnings False: DoCmd.RunSQL sql: DoCmd.SetWarnings True
    '
    ' Loop throught --> in case the target is used in the "source"-query self, filter out the id_datset of the form
    Set rst = dbs.OpenRecordset("SELECT * FROM tmp_effected_datasets WHERE id_dataset <> '" & Me.id_dataset & "'", RecordsetTypeEnum.dbOpenSnapshot, RecordsetOptionEnum.dbForwardOnly, LockTypeEnum.dbPessimistic): Do While Not rst.EOF
        '
        ' Rebuild "Source Query" of involved "Datasets"
        sql = emp & emp & "SELECT * FROM dta_dataset"
        sql = sql & nwl & "WHERE id_model   = '" & rst!id_model & "'"
        sql = sql & nwl & "AND   id_dataset = '" & rst!id_dataset & "'"
        '
        ' re-build "Source Query"
        l_tx_source_query = build_source_query(rst!id_model, rst!id_dataset, False)
        Set dst = dbs.OpenRecordset(sql): dst.Edit: dst!tx_source_query = l_tx_source_query: dst.Update: dst.Close
        '
        ' Parse SQL Statement
        Call parse_transformation_parts(rst!id_model, rst!id_dataset)
        '
        ' Update Repository file(s)
        Call export_dataset_and_related_definitions(rst!id_dataset)
        Call build_sql_file_dataset
        '
    rst.MoveNext: Loop: rst.Close
    '
    ' (Re-)Build all Schema, Table and Procedure ddl-fiels
    Call all_create_dataset_specified_procedure
    '
End Sub
