Private Sub Form_Load()
    '
    ' Initialize id_model/dataset
    Me.id_model = Nz(Me.id_model, id_model_default)
    Me.id_dataset = Nz(Me.id_dataset, get_random_code(32))
    '
    ' Default Setting
    Call set_buttons(Me)
    Call set_attributes(Me)
    Call is_ingestion_Click
    '
    ' Set Drop Down Lists
    DoCmd.SetWarnings False
    Me.id_group.RowSource = "SELECT id, display FROM ddl_ohg_groups WHERE id_model = '" & Me.id_model & "'"
    Me.id_development_status.RowSource = "SELECT id, display FROM ddl_srd_development_status WHERE id_model = '" & Me.id_model & "'"
    DoCmd.SetWarnings True
    '
    ' If "Other" Model then Current then open up "Reference Dataset"-button.
    Me.btn_Reference_Dataset.Enabled = (Me.id_model <> id_model_default)
    '
    ' Check if "Dataset" is referenced from "other"-model.
    Me.lbl_is_referenced.Visible = is_referenced_dataset(Me.id_model, Me.id_dataset)
    '
    ' when "Referenced"-dataset open up the following fields
    If (Me.lbl_is_referenced.Visible = True) Then
        Me.pg_parameters.Visible = True
        Me.dta_parameter_value.Visible = True
        Me.dta_parameter_value.Locked = True
        Me.dta_parameter_value.Enabled = True
    End If
    If (Me.lbl_is_referenced.Visible = False) Then
        Me.pg_parameters.Visible = Me.is_ingestion
        Me.dta_parameter_value.Visible = True
        Me.dta_parameter_value.Locked = False
        Me.dta_parameter_value.Enabled = True
    End If
    '
End Sub


Private Sub is_ingestion_Click()
    '
    ' hide or show "pg_sql_for_meta".
    Me.pg_sql_for_meta.Visible = True 'Nz(Me.is_ingestion, False)
    Me.pg_parameters.Visible = Nz(Me.is_ingestion, False)
    Me.btn_create_source_query_from_attributes.Visible = Nz(Me.is_ingestion, False)
    Call set_proper_prefix_schema
    '
    ' Change the color of form header
    If (Mid(Me.nm_target_schema, 1, 2) = "dq") Then
      Me.img_logo_dataquality.Width = 1210
      Me.img_logo_ingestion.Width = 0
      Me.img_logo_transformation.Width = 0
      Me.Formulierkoptekst.BackColor = RGB(101, 127, 140)
    Else
      If (Me.is_ingestion = True) Then
        Me.img_logo_dataquality.Width = 0
        Me.img_logo_ingestion.Width = 1310
        Me.img_logo_transformation.Width = 0
        Me.Formulierkoptekst.BackColor = RGB(15, 48, 79)
      Else ' Transformation
        Me.img_logo_dataquality.Width = 0
        Me.img_logo_ingestion.Width = 0
        Me.img_logo_transformation.Width = 1240
        Me.Formulierkoptekst.BackColor = RGB(71, 152, 100)
      End If
    End If
    '
End Sub

Private Sub nm_target_schema_LostFocus()
  '
  ' Local Variables
  Dim nm_target_schema_old As String: nm_target_schema_old = Me.nm_target_schema.OldValue
  Call set_proper_prefix_schema
  Dim nm_target_schema_new As String: nm_target_schema_new = Me.nm_target_schema
  Dim tx_source_table     As String: tx_source_table = "[" & nm_target_schema_new & "].[" & Me.nm_target_table & "]"
  '
  ' Replace "Old"-source_table with "new"
  Me.tx_source_query = Replace(Me.tx_source_query, Replace("[" & nm_target_schema_old & "].[" & Me.nm_target_table & "]", " ", ""), tx_source_table)
  Me.tx_source_query = Replace(Me.tx_source_query, Replace(" " & nm_target_schema_old & " .[" & Me.nm_target_table & "]", " ", ""), tx_source_table)
  Me.tx_source_query = Replace(Me.tx_source_query, Replace(" " & nm_target_schema_old & " . " & Me.nm_target_table & " ", " ", ""), tx_source_table)
  Me.tx_source_query = Replace(Me.tx_source_query, Replace("[" & nm_target_schema_old & "]. " & Me.nm_target_table & " ", " ", ""), tx_source_table)
  '
  ' Save the Record
  DoCmd.RunCommand acCmdSaveRecord
  '
End Sub
Public Sub set_proper_prefix_schema()
    
    Dim is_schema_prefix_missing As Boolean
    Dim tx_schema_prefix_missing As String
    Dim cd_schema_prefix         As String
    
    is_schema_prefix_missing = False
    tx_schema_prefix_missing = "Schema-names should start with ""psa_"" for ""Ingestions"" and ""dta_"" for ""Transformations""." & vbNewLine _
                             & "Should if be added? (Yes/No)"
    
    If Mid(Me.nm_target_schema, 1, 2) = "dq" Then: Exit Sub
    
    If (Me.is_ingestion = True) Then
        cd_schema_prefix = "psa_"
    End If
    
    If (Me.is_ingestion = False) Then
        cd_schema_prefix = "dta_"
    End If
    
    If (Left(Me.nm_target_schema, 4) <> cd_schema_prefix) Then
        is_schema_prefix_missing = True
    End If

    If (is_schema_prefix_missing) Then
        
        If (Left(Me.nm_target_schema, 4) = "psa_") Then
            Me.nm_target_schema = Mid(Me.nm_target_schema, 5)
        End If
        If (Left(Me.nm_target_schema, 3) = "psa") Then
            Me.nm_target_schema = Mid(Me.nm_target_schema, 4)
        End If
        If (Left(Me.nm_target_schema, 4) = "dta_") Then
            Me.nm_target_schema = Mid(Me.nm_target_schema, 5)
        End If
        If (Left(Me.nm_target_schema, 3) = "dta") Then
            Me.nm_target_schema = Mid(Me.nm_target_schema, 5)
        End If
        
        Me.nm_target_schema = cd_schema_prefix & Me.nm_target_schema
            
    End If
    
End Sub

Private Sub nm_target_table_LostFocus()
  '
  ' Local Variables
  Dim nm_target_table_old As String: nm_target_table_old = Me.nm_target_table.OldValue
  Dim nm_target_table_new As String: nm_target_table_new = Me.nm_target_table
  Dim tx_source_table     As String: tx_source_table = "[" & Me.nm_target_schema & "].[" & nm_target_table_new & "]"
  '
  ' Replace "Old"-source_table with "new"
  Me.tx_source_query = Replace(Me.tx_source_query, Replace("[" & Me.nm_target_schema & "].[" & nm_target_table_old & "]", " ", ""), tx_source_table)
  Me.tx_source_query = Replace(Me.tx_source_query, Replace(" " & Me.nm_target_schema & " .[" & nm_target_table_old & "]", " ", ""), tx_source_table)
  Me.tx_source_query = Replace(Me.tx_source_query, Replace(" " & Me.nm_target_schema & " . " & nm_target_table_old & " ", " ", ""), tx_source_table)
  Me.tx_source_query = Replace(Me.tx_source_query, Replace("[" & Me.nm_target_schema & "]. " & nm_target_table_old & " ", " ", ""), tx_source_table)
  '
  ' Save the Record
  DoCmd.RunCommand acCmdSaveRecord
  '
End Sub

Private Sub tx_source_query_AfterUpdate()
    Dim result As SQLAnalysisResult
    Dim report As String
    is_source_query_ok = True
    result = AnalyzeSQL(Me.tx_source_query)
    If (result.HasSubqueries = True Or result.HasCTEs = True) Then
        report = GetSQLAnalysisReport(result)
        Call MsgBox("Use of Subqueries and CTE is NOT allowed, create separate dataset instead!" & _
                    vbNewLine & GetSQLAnalysisReport(result), _
                    vbCritical, "!!! Source Query Invalid !!!")
        is_source_query_ok = False
    End If
End Sub

Private Sub tx_source_query_LostFocus()
    '
    Call tx_source_query_AfterUpdate
    '
End Sub