Private Sub btn_Save_Click()
    '
    ' Save "Dataset"  to Export.
    If (Nz(Me.id_dq_requirement, "-1") = "-1") Then: Exit Sub
    DoCmd.RunCommand acCmdSaveRecord
    Call export_table("dqm", "dq_requirement")
    '
End Sub

Private Sub btn_delete_Click()
    '
    ' Delete Record in Access DB
    Dim fso As FileSystemObject: Set fso = New FileSystemObject
    Dim sql As String: sql = "DELETE * FROM dqm_dq_requirement WHERE id_dq_requirement = '" & Me.id_dq_requirement & "'"
    If (MsgBox("This will remove all related to then `DQ Requirements`, clikc `Yes` to continue.", vbYesNo, "Delete Dataset") = vbYes) Then
        DoCmd.SetWarnings False: DoCmd.RunSQL sql: DoCmd.SetWarnings True
        Call export_table("dqm", "dq_requirement")
        Form_dqm_dq_requirement_list.Recalc
        DoCmd.Close acForm, "dqm_dq_requirement", acSaveNo
    End If
    '
End Sub

Private Sub btn_Back_to_Development_Click():  Call update_development_status("DEV"): End Sub
Private Sub btn_Deploy_to_Acceptance_Click(): Call update_development_status("UAT"): End Sub
Private Sub btn_Deploy_to_Production_Click(): Call update_development_status("PRD"): End Sub
Private Sub btn_Move_to_Ad_Hoc_Click():       Call update_development_status("AHC"): End Sub
Private Sub btn_Move_to_Out_of_Scope_Click(): Call update_development_status("OOS"): End Sub

Private Sub Form_BeforeInsert(Cancel As Integer):
    Me.id_dq_requirement = get_random_code()
    Me.id_development_status = get_id_development_status("DEV")
End Sub

Private Sub update_development_status(cd_development_status As String)
    '
    ' Update "Development"-status to "Development"
    Me.id_development_status = get_id_development_status(cd_development_status)
    DoCmd.RunCommand acCmdSaveRecord
    Call set_buttons(Me)
    Call export_table("dqm", "dq_requirement")
    '
End Sub

Private Sub Form_Load()
    Call set_buttons(Me)
    Call set_attributes(Me)
End Sub