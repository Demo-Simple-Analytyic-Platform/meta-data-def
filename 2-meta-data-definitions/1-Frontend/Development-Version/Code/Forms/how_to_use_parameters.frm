                    FontSize =10
                    Name ="Bijschrift1"
                    Caption ="In the the \"parameter\"-value 4 \"variables\" can be used to provide more flexi"
                        "bility, these are always enclosed with \"<@\" and \">\", with the name of the \""
                        "variable\" in between.\015\012- dt_previous_stand : This is the \"Datetime\" use"
                        "d in the previous \"run\" to filter on a fixed time period\015\012              "
                        "        between \"previous\"- and \"current\"-stand.\015\012- dt_current_stand  "
                        ": This is the \"Datetime\" used in the current \"run\" to filter on a fixed time"
                        " period\015\012                      between \"previous\"- and \"current\"-stand"
                        ".\015\012- ni_previous_epoch : This is the \"epoch\" used in the previous \"run\""
                        " to filter on a fixed time period\015\012                      between \"previou"
                        "s\"- and \"current\"-epoch.\015\012- dt_current_stand  : This is the \"epoch\" u"
                        "sed in the current \"run\" to filter on a fixed time period\015\012             "
                        "         between \"epoch\"- and \"current\"-epoch.\015\012\015\012epoch : The Un"
                        "ix epoch (or Unix time or POSIX time or Unix timestamp) is the number of seconds"
                        " that have elapsed since \015\012        January 1, 1970 (midnight UTC/GMT), not"
                        " counting leap seconds (in ISO 8601: 1970-01-01T00:00:00Z). \015\012        see "
                        "for more info https://www.epochconverter.com/\015\012 "
                    FontName ="Consolas"
