'
' Generate "Unique"-code
Private Sub Form_BeforeInsert(Cancel As Integer): Me.id_dq_threshold = get_random_code(): End Sub
'
' After Insert/update/delete "export" to "Repository".
Private Sub Form_AfterDelConfirm(Status As Integer): Call save: End Sub
Private Sub Form_AfterInsert():                      Call save: End Sub
Private Sub Form_AfterUpdate():                      Call save: End Sub
'
' Save "DQ Threhold"-data
Private Sub save()
    Dim sq As String: sq = "SELECT id_dataset FROM dqm_dq_control WHERE id_dq_control = '" & Me.id_dq_control & "'"
    Dim rs As Recordset: Set rs = CurrentDb.OpenRecordset(sq)
    Call export_dataset_and_related_definitions(rs.fields("id_dataset"))
    Call build_sql_file_dataset
End Sub